# Copy this file to .env and fill secrets locally.
# Never commit the real .env file.

# STT mode:
# - local: run local Whisper first, then API fallback if local fails.
# - mock: deterministic transcript for tests and contract demos.
MURPHY_STT_MODE=local

# Local Whisper large-v3-turbo runtime.
# openai-whisper uses the turbo alias for large-v3-turbo.
MURPHY_STT_LOCAL_MODEL=turbo

# OpenAI Transcriptions API fallback.
OPENAI_API_KEY=
MURPHY_STT_API_MODEL=whisper-1
MURPHY_STT_API_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
MURPHY_STT_API_TIMEOUT_S=60

# Developer C Understanding Agent mode:
# - rule: deterministic semantic analyzer for tests and contract demos.
# - llm: optional OpenAI-assisted semantic analyzer with rule fallback.
MURPHY_UNDERSTANDING_MODE=llm
MURPHY_UNDERSTANDING_LLM_MODEL=gpt-4o-mini
MURPHY_UNDERSTANDING_LLM_TIMEOUT_SECONDS=10

# TTS mode:
# - fake: deterministic valid wav artifact for tests and contract demos.
# - real: run Developer A's real Kokoro provider and serve the generated wav.
MURPHY_TTS_MODE=real

# NPC dialogue generation mode:
# - rule: deterministic Developer A dialogue policy.
# - llm: optional OpenAI NPC dialogue generation before Kokoro TTS.
MURPHY_NPC_DIALOGUE_MODE=llm
NPC_DIALOGUE_LLM_MODEL=gpt-4o-mini
NPC_DIALOGUE_LLM_TIMEOUT_SECONDS=10

# Developer B feedback/hint generation mode:
# - rule: deterministic Developer B feedback and hint text.
# - llm: optional OpenAI-assisted learning feedback text and rubric candidates.
DEV_B_FEEDBACK_LLM_MODE=llm
DEV_B_FEEDBACK_LLM_MODEL=gpt-4o-mini
DEV_B_FEEDBACK_LLM_TIMEOUT_SECONDS=10
