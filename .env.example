# Copy this file to .env and fill secrets locally.
# Never commit the real .env file.

# STT mode:
# - local: run local Whisper first, then API fallback if local fails.
# - mock: deterministic transcript for tests and contract demos.
MURPHY_STT_MODE=local

# Local Whisper large-v3-turbo runtime.
# openai-whisper uses the turbo alias for large-v3-turbo.
MURPHY_STT_LOCAL_MODEL=turbo

# OpenAI Transcriptions API fallback.
OPENAI_API_KEY=
MURPHY_STT_API_MODEL=whisper-1
MURPHY_STT_API_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
MURPHY_STT_API_TIMEOUT_S=10

# ElevenLabs realtime STT relay for Unreal subtitles.
# The API key stays server-side in Developer C backend. Do not put it in Unreal.
ELEVENLABS_API_KEY=
ELEVENLABS_REALTIME_STT_ENDPOINT=wss://api.elevenlabs.io/v1/speech-to-text/realtime
ELEVENLABS_REALTIME_STT_MODEL=scribe_v2_realtime
ELEVENLABS_REALTIME_AUDIO_FORMAT=pcm_16000
ELEVENLABS_REALTIME_COMMIT_STRATEGY=manual
ELEVENLABS_REALTIME_RECEIVE_TIMEOUT_S=0.2
ELEVENLABS_REALTIME_COMMIT_TIMEOUT_S=3.0
ELEVENLABS_REALTIME_ESTIMATED_COST_PER_MINUTE_USD=0

# Realtime STT debug logging:
# - off: do not append standalone realtime STT AgentRun records.
# - debug: append token/cost/audio/provider metadata to unified AgentRun logs.
MURPHY_STT_DEBUG_LOG_MODE=off

# Academy Gemma4 vLLM fallback.
# OpenAI-compatible /v1 server; API key is a placeholder for the local vLLM server.
GEMMA4_VLLM_BASE_URL=http://100.95.34.69:8001/v1
GEMMA4_VLLM_MODEL=google/gemma-4-26B-A4B-it
GEMMA4_VLLM_API_KEY=dummy

# Developer C Understanding Agent mode:
# - rule: deterministic semantic analyzer for tests and contract demos.
# - llm: optional LLM-assisted semantic analyzer with rule fallback.
MURPHY_UNDERSTANDING_MODE=llm
# Primary provider is OpenAI. Enable fallback below when the OpenAI key is unavailable.
MURPHY_UNDERSTANDING_LLM_PROVIDER=openai
MURPHY_UNDERSTANDING_LLM_FALLBACK=none
MURPHY_UNDERSTANDING_LLM_MODEL=gpt-5.4-mini
MURPHY_UNDERSTANDING_LLM_TIMEOUT_SECONDS=10

# Unreal request capture:
# - off: do not store incoming Unreal request bodies.
# - debug: store multipart turn.json, audio.wav, and metadata.json for debugging.
MURPHY_UNREAL_REQUEST_CAPTURE_MODE=off
MURPHY_UNREAL_REQUEST_CAPTURE_ROOT=backend/runtime/generated/unreal_requests

# TTS mode:
# - fake: deterministic valid wav artifact for tests and contract demos.
# - real: run Developer A's selected real TTS provider and serve the generated audio.
MURPHY_TTS_MODE=real
MURPHY_TTS_PROVIDER=elevenlabs

# DEPRECATED: 모든 NPC를 단일 목소리로 강제하던 레거시 변수입니다.
# 이제 목소리(Voice)는 npc_roster_service의 elevenlabs_voice_id 및 _NPC_EDGE_VOICES에 설정된 기본값으로 자동 결정됩니다.
# 운영 중 특정 목소리로 일시 강제 오버라이드가 필요한 경우 아래 *_FORCE 변수를 주입하십시오.
# MURPHY_EDGE_TTS_VOICE=en-US-GuyNeural
# MURPHY_ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17

# MURPHY_EDGE_TTS_VOICE_FORCE=
# MURPHY_ELEVENLABS_VOICE_ID_FORCE=

MURPHY_EDGE_TTS_RATE=-5%
MURPHY_EDGE_TTS_VOLUME=+0%
MURPHY_EDGE_TTS_PITCH=-2Hz
MURPHY_EDGE_TTS_OUTPUT_FORMAT=wav
MURPHY_ELEVENLABS_API_KEY=
MURPHY_ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
MURPHY_ELEVENLABS_MODEL_ID=eleven_flash_v2_5
MURPHY_ELEVENLABS_API_OUTPUT_FORMAT=mp3_44100_128
MURPHY_ELEVENLABS_OUTPUT_FORMAT=wav
MURPHY_ELEVENLABS_STABILITY=0.52
MURPHY_ELEVENLABS_SIMILARITY_BOOST=0.82
MURPHY_ELEVENLABS_STYLE=0.42
MURPHY_ELEVENLABS_SPEED=0.80
MURPHY_ELEVENLABS_USE_SPEAKER_BOOST=true
MURPHY_ELEVENLABS_TIMEOUT_SECONDS=60

# NPC dialogue generation mode:
# - rule: deterministic Developer A dialogue policy.
# - llm: optional LLM NPC dialogue generation before Kokoro TTS.
MURPHY_NPC_DIALOGUE_MODE=llm
# Primary provider is OpenAI. Set fallback to gemma4_vllm for academy server fallback.
NPC_DIALOGUE_LLM_PROVIDER=openai
NPC_DIALOGUE_LLM_FALLBACK=none
NPC_DIALOGUE_LLM_MODEL=gpt-5.4-mini
NPC_DIALOGUE_LLM_TIMEOUT_SECONDS=10

# Developer B feedback/hint generation mode:
# - rule: deterministic Developer B feedback and hint text.
# - llm: optional OpenAI-assisted learning feedback text and rubric candidates.
DEV_B_FEEDBACK_LLM_MODE=llm
DEV_B_FEEDBACK_LLM_MODEL=gpt-5.4-mini
DEV_B_FEEDBACK_LLM_TIMEOUT_SECONDS=10

# NPC profanity response mode:
# - off: default. responds politely even if the player is rude or uses profanity.
# - firm: delivers a stern warning for rude/insulting inputs (tier 1+) without using profanity.
# - mirror: allows mirroring mild or strong profanity under tier 2+. Affects game ratings.
MURPHY_NPC_PROFANITY_MIRROR_MODE=mirror

# Maximum intensity of mirrored profanity allowed under 'mirror' mode:
# - mild: damn, hell, screw, crap, shut up, heck, bother. (default)
# - strong: mild + shit, ass, bullshit, piss. Always blocks slurs and hate speech.
MURPHY_NPC_PROFANITY_MIRROR_MAX_INTENSITY=mild

